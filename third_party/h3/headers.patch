+    fn qpack_fields(fields: Vec<HeaderField>) -> Vec<HeaderField> {
+        let mut wire = bytes::BytesMut::new();
+        crate::qpack::encode_stateless(&mut wire, fields).unwrap();
+        crate::qpack::decode_stateless(&mut wire.as_ref(), u64::MAX)
+            .unwrap()
+            .fields
+    }
