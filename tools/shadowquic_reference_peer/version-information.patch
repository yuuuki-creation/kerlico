 func (c *Conn) handleTransportParameters(params *wire.TransportParameters) error {
+	// RFC9369 v2 必须提供版本信息；不允许受认证信息与载体版本不同。
+	if params.ChosenVersion != 0 && params.ChosenVersion != c.version || c.version == protocol.Version2 && params.ChosenVersion == 0 {
+		return &qerr.TransportError{ErrorCode: qerr.TransportErrorCode(0x11), ErrorMessage: "版本信息缺失或与当前版本不一致"}
+	}
 	if c.qlogger != nil {
 		c.qlogTransportParameters(params, c.perspective.Opposite(), false)
 	}
