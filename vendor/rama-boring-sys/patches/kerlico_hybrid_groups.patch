+// The NIST-curve hybrids put the ECDHE share and secret first, unlike
+// X25519MLKEM768. Reuse the ordinary ECDHE and ML-KEM primitives.
+template <typename Private, typename Public, size_t PublicBytes,
+          size_t CiphertextBytes, auto GenerateKem, auto ParseKem,
+          auto EncapKem, auto DecapKem>
+class EcdheMlKemKeyShare : public SSLKeyShare {
+ public:
+  EcdheMlKemKeyShare(const EC_GROUP *group, uint16_t ec_id, uint16_t id)
+      : ec_(group, ec_id), id_(id),
+        point_size_(1 + 2 * ((EC_GROUP_get_degree(group) + 7) / 8)) {}
+
+  uint16_t GroupID() const override { return id_; }
+
+  bool Generate(CBB *out) override {
+    if (!ec_.Generate(out)) {
+      return false;
+    }
+    uint8_t public_key[PublicBytes];
+    GenerateKem(public_key, /*optional_out_seed=*/nullptr, &private_key_);
+    return CBB_add_bytes(out, public_key, sizeof(public_key));
+  }
+
+  bool Encap(CBB *out, Array<uint8_t> *secret, uint8_t *alert,
+             Span<const uint8_t> peer) override {
+    if (peer.size() != point_size_ + PublicBytes) {
+      return Invalid(alert);
+    }
+    Public key;
+    CBS kem;
+    CBS_init(&kem, peer.data() + point_size_, PublicBytes);
+    if (!ParseKem(&key, &kem) || CBS_len(&kem) != 0) {
+      return Invalid(alert);
+    }
+    Array<uint8_t> ec_secret;
+    if (!ec_.Encap(out, &ec_secret, alert, peer.first(point_size_))) {
+      return false;
+    }
+    if (!Combine(secret, ec_secret)) {
+      return false;
+    }
+    uint8_t ciphertext[CiphertextBytes];
+    EncapKem(ciphertext, secret->data() + ec_secret.size(), &key);
+    return CBB_add_bytes(out, ciphertext, sizeof(ciphertext));
+  }
+
+  bool Decap(Array<uint8_t> *secret, uint8_t *alert,
+             Span<const uint8_t> ciphertext) override {
+    if (ciphertext.size() != point_size_ + CiphertextBytes) {
+      return Invalid(alert);
+    }
+    Array<uint8_t> ec_secret;
+    if (!ec_.Decap(&ec_secret, alert, ciphertext.first(point_size_)) ||
+        !Combine(secret, ec_secret)) {
+      return false;
+    }
+    if (!DecapKem(secret->data() + ec_secret.size(),
+                  ciphertext.data() + point_size_, CiphertextBytes,
+                  &private_key_)) {
+      return Invalid(alert);
+    }
+    return true;
+  }
+
+ private:
+  static bool Invalid(uint8_t *alert) {
+    *alert = SSL_AD_ILLEGAL_PARAMETER;
+    OPENSSL_PUT_ERROR(SSL, SSL_R_BAD_ECPOINT);
+    return false;
+  }
+
+  static bool Combine(Array<uint8_t> *out, Array<uint8_t> &ec_secret) {
+    const bool ok =
+        out->InitForOverwrite(ec_secret.size() + MLKEM_SHARED_SECRET_BYTES);
+    if (ok) {
+      OPENSSL_memcpy(out->data(), ec_secret.data(), ec_secret.size());
+    }
+    OPENSSL_cleanse(ec_secret.data(), ec_secret.size());
+    return ok;
+  }
+
+  ECKeyShare ec_;
+  uint16_t id_;
+  size_t point_size_;
+  Private private_key_;
+};
