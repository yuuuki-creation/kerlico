+int RAMA_SSL_prepare_tls12_shares(SSL *ssl, const uint16_t *groups, size_t count,
+                                 uint8_t *out, size_t capacity,
+                                 size_t *out_len) {
+  SSLImpl *impl = FromOpaque(ssl);
+  if (!impl->config || impl->server || SSL_is_quic(ssl) || SSL_is_dtls(ssl) ||
+      impl->s3->initial_handshake_complete || count == 0 || count > 3 ||
+      !impl->config->eager_tls12_shares.empty()) {
+    return 0;
+  }
+  SSL_CONFIG *config = impl->config.get();
+  size_t size = 0;
+  for (size_t i = 0; i < count; i++) {
+    uint16_t group = groups[i];
+    if (group != SSL_GROUP_X25519 && group != SSL_GROUP_SECP256R1 &&
+        group != SSL_GROUP_SECP384R1) {
+      config->eager_tls12_shares.clear();
+      return 0;
+    }
+    auto key = SSLKeyShare::Create(group);
+    ScopedCBB cbb;
+    Array<uint8_t> public_key;
+    if (!key || !CBB_init(cbb.get(), 128) || !key->Generate(cbb.get()) ||
+        !CBBFinishArray(cbb.get(), &public_key) ||
+        public_key.size() + 2 > capacity - size) {
+      config->eager_tls12_shares.clear();
+      return 0;
+    }
+    out[size++] = public_key.size() >> 8;
+    out[size++] = public_key.size() & 255;
+    OPENSSL_memcpy(out + size, public_key.data(), public_key.size());
+    size += public_key.size();
+    config->eager_tls12_shares.PushBack(
+        {std::move(key), std::move(public_key)});
+  }
+  *out_len = size;
+  return 1;
+}
