+bool ssl_mutate_client_hello(SSL_HANDSHAKE *hs, Span<uint8_t> body) {
+  auto *ssl = hs->ssl;
+  auto mutate = ssl->config->client_hello_mutator;
+  if (!mutate) {
+    return true;
+  }
+  constexpr size_t kRandomOffset = 2;
+  constexpr size_t kSessionOffset = kRandomOffset + SSL3_RANDOM_SIZE + 1;
+  const size_t id_len = hs->session_id.size();
+  if (hs->selected_ech_config || body.size() < kSessionOffset + id_len ||
+      body[kSessionOffset - 1] != id_len || body.size() > 0xffffff) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_SHOULD_NOT_HAVE_BEEN_CALLED);
+    return false;
+  }
+  Array<uint8_t> message;
+  if (!message.InitForOverwrite(4 + body.size())) {
+    return false;
+  }
+  message[0] = SSL3_MT_CLIENT_HELLO;
+  message[1] = body.size() >> 16;
+  message[2] = (body.size() >> 8) & 255;
+  message[3] = body.size() & 255;
+  OPENSSL_memcpy(message.data() + 4, body.data(), body.size());
+  uint8_t random[SSL3_RANDOM_SIZE], id[SSL_MAX_SSL_SESSION_ID_LENGTH];
+  OPENSSL_memcpy(random, body.data() + kRandomOffset, sizeof(random));
+  OPENSSL_memcpy(id, body.data() + kSessionOffset, id_len);
+  if (!mutate(ssl, message.data(), message.size(), random, id, id_len)) {
+    OPENSSL_PUT_ERROR(SSL, ERR_R_INTERNAL_ERROR);
+    return false;
+  }
+  OPENSSL_memcpy(body.data() + kRandomOffset, random, sizeof(random));
+  OPENSSL_memcpy(ssl->s3->client_random, random, sizeof(random));
+  OPENSSL_memcpy(body.data() + kSessionOffset, id, id_len);
+  OPENSSL_memcpy(hs->session_id.data(), id, id_len);
+  ssl->config->client_hello_mutator = nullptr;
+  return true;
+}
