{
  "version": 1,
  "outbounds": [
    {
      "tag": "proxy",
      "type": "vless",
      "options": {
        "server": { "host": "server.invalid", "port": 443 },
        "uuid": "00000000-0000-0000-0000-000000000000",
        "transport": "tcp",
        "flow": "",
