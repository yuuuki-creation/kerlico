{
  "version": 2,
  "outbounds": [
    { "tag": "direct", "type": "direct" },
    { "tag": "block", "type": "reject" },
    {
      "tag": "proxy",
      "type": "ss2022",
      "options": {
        "server": "proxy.example.com",
        "port": 8388,
        "method": "2022-blake3-aes-128-gcm",
        "key": "AAAAAAAAAAAAAAAAAAAAAA=="
      }
    }
  ],
  "local_inbounds": [
    { "tag": "socks", "type": "socks", "listen": "127.0.0.1:1080", "outbound": "proxy", "options": {} }
  ],
  "routes": [
    { "outbound": "block", "domain_suffix": ["ads.example"] },
    { "outbound": "direct", "ip_cidr": ["10.0.0.0/8", "192.168.0.0/16"] }
  ],
  "telemetry": { "directory": "state/telemetry" }
}
